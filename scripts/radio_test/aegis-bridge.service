# Legacy wrapper unit delegating to the parameterized onboard runtime (#59).
# Prefer deploy/aegis-onboard.service for production systemd installations.
[Unit]
Description=AegisFlight companion bridge (bench wrapper)
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
Group=dialout
EnvironmentFile=-/etc/aegisflight/onboard.env
ExecStart=/usr/bin/env bash -lc 'exec "${AEGIS_HOME:-$PWD}/scripts/radio_test/pi_autostart.sh"'
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
