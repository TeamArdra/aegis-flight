# Unified AegisFlight companion service unit (#59).
# Install:
#   sudo cp deploy/aegis-onboard.service /etc/systemd/system/
#   sudo cp deploy/onboard.env.example /etc/aegisflight/onboard.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now aegis-onboard
[Unit]
Description=AegisFlight Unified Companion Runtime
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
User=aegisflight
Group=dialout
WorkingDirectory=/opt/aegisflight
EnvironmentFile=-/etc/aegisflight/onboard.env
Environment=AEGIS_ONBOARD_CONFIG=/etc/aegisflight/onboard.yaml
ExecStart=/opt/aegisflight/.venv/bin/aegis onboard --config ${AEGIS_ONBOARD_CONFIG}
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
